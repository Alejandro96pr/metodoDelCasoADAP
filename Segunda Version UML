@startuml
"Usuario" as User
"Administrador" as Admin
"SuperAdmin" as Super
Admin --|> User
Admin <|-- Super

'Casos de Todos'
usecase "Iniciar Sesión"as CU01
usecase "Validar dominio" as CU01_Val
usecase "Recuperar contraseña" as CU02

'Casos de Usuario'
usecase "Gestionar Empresas" as CU03
usecase "Buscar Clientes y Facturas" as CU04
usecase "Preparar y Emitir facturas" as CU05
usecase "Revisión anual de tramo" as CU06


'Casos de Administrador'
usecase "Crear Usuario" as CU0
usecase "Asignar Clientes a Usuario" as CU4
usecase "Ver panel Global" as CU1


'Casos de SuperAministrador'
usecase "Cambiar Ajustes y consultar Actividad" as CU2

User -- CU01
User-- CU02
User -- CU03
User -- CU04
User -- CU05
User -- CU06

Admin -- CU0
Admin --CU4
Admin -- CU1

Super -- CU2

CU01 ..> CU01_Val : <include>


@enduml
