
CREATE TABLE CONFIGURACION_SISTEMA (
  id_configuracion NUMBER GENERATED BY DEFAULT AS IDENTITY,
  version NUMBER(10) NOT NULL,
  vigente_desde TIMESTAMP NOT NULL,
  vigente_hasta TIMESTAMP,
  activa CHAR(1) DEFAULT 'S' NOT NULL,
  moneda_defecto CHAR(3) DEFAULT 'EUR' NOT NULL,
  iva_defecto NUMBER(5,2) DEFAULT 21.00 NOT NULL,
  dias_vencimiento NUMBER(4) DEFAULT 30 NOT NULL,
  version_plantilla_pdf VARCHAR2(30) NOT NULL,
  CONSTRAINT pk_config_sistema PRIMARY KEY (id_configuracion),
  CONSTRAINT uq_config_version UNIQUE (version),
  CONSTRAINT ck_config_version CHECK (version >= 1),
  CONSTRAINT ck_config_activa CHECK (activa IN ('S','N')),
  CONSTRAINT ck_config_iva CHECK (iva_defecto BETWEEN 0 AND 100),
  CONSTRAINT ck_config_dias CHECK (dias_vencimiento >= 0),
  CONSTRAINT ck_config_fechas CHECK (vigente_hasta IS NULL OR vigente_hasta >= vigente_desde)
);

CREATE UNIQUE INDEX uq_config_sistema_activa ON CONFIGURACION_SISTEMA
(CASE WHEN activa = 'S' THEN 1 END);

CREATE TABLE OPERACION_ARCHIVO (
  id_operacion NUMBER(10) GENERATED BY DEFAULT AS IDENTITY,
  tipo VARCHAR2(30) NOT NULL,
  estado VARCHAR2(20) DEFAULT 'PENDIENTE' NOT NULL,
  CONSTRAINT pk_operacion_archivo PRIMARY KEY (id_operacion),
  CONSTRAINT ck_op_archivo_tipo CHECK (tipo IN ('IMPORTACION_CLIENTES','IMPORTACION_COBROS','EXPORTACION_INFORME','EXPORTACION_FACTURAS')),
  CONSTRAINT ck_op_archivo_estado CHECK (estado IN ('PENDIENTE','PREVISUALIZADA','VALIDADA','CONFIRMADA','ERROR'))
);

CREATE TABLE EJECUCION_AUTOMATICA (
  id_ejecucion NUMBER GENERATED BY DEFAULT AS IDENTITY,
  tipo VARCHAR2(30) NOT NULL,
  estado VARCHAR2(20) DEFAULT 'PENDIENTE' NOT NULL,
  iniciada_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
  finalizada_en TIMESTAMP,
  reintentos NUMBER(3) DEFAULT 0 NOT NULL,
  detalle_error VARCHAR2(1000),
  CONSTRAINT pk_ejecucion_auto PRIMARY KEY (id_ejecucion),
  CONSTRAINT ck_ejec_tipo CHECK (tipo IN ('EMISION_FACTURAS','ENVIO_FACTURAS','RECORDATORIOS_COBRO','CONCILIACION_AUTOMATICA')),
  CONSTRAINT ck_ejec_estado CHECK (estado IN ('PENDIENTE','EN_CURSO','COMPLETADA','ERROR','REINTENTADA')),
  CONSTRAINT ck_ejec_reintentos CHECK (reintentos >= 0),
  CONSTRAINT ck_ejec_fechas CHECK (finalizada_en IS NULL OR finalizada_en >= iniciada_en)
);

CREATE TABLE EVENTO_AUDITORIA (
  id_evento NUMBER(10) GENERATED BY DEFAULT AS IDENTITY,
  actor_correo VARCHAR2(150),
  fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
  accion VARCHAR2(255) NOT NULL,
  operacion_archivo_id_operacion NUMBER(10),
  ejecucion_automatica_id_ejecucion NUMBER(10),
  CONSTRAINT pk_evento_auditoria PRIMARY KEY (id_evento),
  CONSTRAINT fk_evento_operacion FOREIGN KEY (operacion_archivo_id_operacion) REFERENCES OPERACION_ARCHIVO(id_operacion),
  CONSTRAINT fk_evento_ejecucion FOREIGN KEY (ejecucion_automatica_id_ejecucion) REFERENCES EJECUCION_AUTOMATICA(id_ejecucion),
  CONSTRAINT ck_evento_origen CHECK (operacion_archivo_id_operacion IS NULL OR ejecucion_automatica_id_ejecucion IS NULL)
);


CREATE TABLE PERIODO_CONTABLE (
  id_periodo NUMBER GENERATED BY DEFAULT AS IDENTITY,
  anio NUMBER(4) NOT NULL,
  mes NUMBER(2) NOT NULL,
  fecha_inicio DATE NOT NULL,
  fecha_fin DATE NOT NULL,
  cerrado CHAR(1) DEFAULT 'N' NOT NULL,
  fecha_cierre TIMESTAMP,
  CONSTRAINT pk_periodo_contable PRIMARY KEY (id_periodo),
  CONSTRAINT uq_periodo_anio_mes UNIQUE (anio, mes),
  CONSTRAINT ck_periodo_mes CHECK (mes BETWEEN 1 AND 12),
  CONSTRAINT ck_periodo_fechas CHECK (fecha_fin >= fecha_inicio),
  CONSTRAINT ck_periodo_cerrado CHECK (cerrado IN ('S','N')),
  CONSTRAINT ck_periodo_cierre CHECK ((cerrado = 'N' AND fecha_cierre IS NULL) OR (cerrado = 'S' AND fecha_cierre IS NOT NULL))
);

CREATE TABLE SERIE_FACTURACION (
  id_serie NUMBER GENERATED BY DEFAULT AS IDENTITY,
  codigo VARCHAR2(20) NOT NULL,
  descripcion VARCHAR2(200),
  siguiente_numero NUMBER(10) DEFAULT 1 NOT NULL,
  activa CHAR(1) DEFAULT 'S' NOT NULL,
  CONSTRAINT pk_serie_facturacion PRIMARY KEY (id_serie),
  CONSTRAINT uq_serie_codigo UNIQUE (codigo),
  CONSTRAINT ck_serie_siguiente CHECK (siguiente_numero >= 1),
  CONSTRAINT ck_serie_activa CHECK (activa IN ('S','N'))
);

CREATE TABLE FACTURA (
  id_factura NUMBER(10) GENERATED BY DEFAULT AS IDENTITY,
  serie_facturacion_codigo VARCHAR2(10),
  numero NUMBER(10),
  nif_cliente VARCHAR2(20) NOT NULL,
  id_suscripcion NUMBER(10),
  periodo_contable_id_periodo NUMBER(10) NOT NULL,
  factura_id_factura NUMBER(10),
  total NUMBER(12,2) DEFAULT 0 NOT NULL,
  saldo_pendiente NUMBER(12,2) DEFAULT 0 NOT NULL,
  estado_cobro VARCHAR2(20) DEFAULT 'BORRADOR' NOT NULL,
  CONSTRAINT pk_factura PRIMARY KEY (id_factura),
  CONSTRAINT uq_factura_serie_num UNIQUE (serie_facturacion_codigo, numero),
  CONSTRAINT fk_factura_serie FOREIGN KEY (serie_facturacion_codigo) REFERENCES SERIE_FACTURACION(codigo),
  CONSTRAINT fk_factura_periodo FOREIGN KEY (periodo_contable_id_periodo) REFERENCES PERIODO_CONTABLE(id_periodo),
  CONSTRAINT fk_factura_original FOREIGN KEY (factura_id_factura) REFERENCES FACTURA(id_factura),
  CONSTRAINT ck_factura_serie_num CHECK ((serie_facturacion_codigo IS NULL AND numero IS NULL) OR (serie_facturacion_codigo IS NOT NULL AND numero IS NOT NULL)),
  CONSTRAINT ck_factura_numero CHECK (numero IS NULL OR numero >= 1),
  CONSTRAINT ck_factura_no_self CHECK (factura_id_factura IS NULL OR factura_id_factura <> id_factura),
  CONSTRAINT ck_factura_estado CHECK (estado_cobro IN ('BORRADOR','PENDIENTE','PARCIAL','COBRADA','ANULADA'))
);

CREATE TABLE LINEA_FACTURA (
  factura_id_factura NUMBER(10) NOT NULL,
  num_linea NUMBER(5) NOT NULL,
  cantidad NUMBER(10,2) NOT NULL,
  precio_unitario NUMBER(12,2) NOT NULL,
  porcentaje_impuesto NUMBER(5,2) NOT NULL,
  CONSTRAINT pk_linea_factura PRIMARY KEY (factura_id_factura, num_linea),
  CONSTRAINT fk_linea_factura FOREIGN KEY (factura_id_factura) REFERENCES FACTURA(id_factura) ON DELETE CASCADE,
  CONSTRAINT ck_linea_num CHECK (num_linea >= 1),
  CONSTRAINT ck_linea_cantidad CHECK (cantidad <> 0),
  CONSTRAINT ck_linea_impuesto CHECK (porcentaje_impuesto BETWEEN 0 AND 100)
);

CREATE TABLE DOCUMENTO_PDF (
  factura_id_factura NUMBER(10) NOT NULL,
  configuracion_sistema_id_configuracion NUMBER(10) NOT NULL,
  hash_contenido VARCHAR2(128) NOT NULL,
  version_diseno VARCHAR2(30) NOT NULL,
  CONSTRAINT pk_documento_pdf PRIMARY KEY (factura_id_factura),
  CONSTRAINT fk_pdf_factura FOREIGN KEY (factura_id_factura) REFERENCES FACTURA(id_factura),
  CONSTRAINT fk_pdf_config FOREIGN KEY (configuracion_sistema_id_configuracion) REFERENCES CONFIGURACION_SISTEMA(id_configuracion)
);


CREATE TABLE RECORDATORIO_COBRO (
  id_recordatorio NUMBER(10) GENERATED BY DEFAULT AS IDENTITY,
  factura_id_factura NUMBER(10) NOT NULL,
  programado_en TIMESTAMP NOT NULL,
  estado_envio VARCHAR2(20) DEFAULT 'PROGRAMADO' NOT NULL,
  CONSTRAINT pk_recordatorio_cobro PRIMARY KEY (id_recordatorio),
  CONSTRAINT fk_rec_factura FOREIGN KEY (factura_id_factura) REFERENCES FACTURA(id_factura),
  CONSTRAINT ck_rec_estado CHECK (estado_envio IN ('PROGRAMADO','ENVIADO','OMITIDO_SIN_DEUDA','FALLIDO','CANCELADO'))
);

CREATE TABLE PAGO (
  id_pago NUMBER GENERATED BY DEFAULT AS IDENTITY,
  importe NUMBER(12,2) NOT NULL,
  referencia VARCHAR2(100) NOT NULL,
  sin_aplicar NUMBER(12,2) NOT NULL,
  fecha_pago DATE NOT NULL,
  metodo_pago VARCHAR2(30) DEFAULT 'TRANSFERENCIA' NOT NULL,
  moneda CHAR(3) DEFAULT 'EUR' NOT NULL,
  CONSTRAINT pk_pago PRIMARY KEY (id_pago),
  CONSTRAINT ck_pago_importe CHECK (importe > 0),
  CONSTRAINT ck_pago_sin_aplicar CHECK (sin_aplicar >= 0 AND sin_aplicar <= importe),
  CONSTRAINT ck_pago_metodo CHECK (metodo_pago IN ('TRANSFERENCIA','DOMICILIACION','TARJETA','OTRO'))
);

CREATE TABLE APLICACION_PAGO (
  id_aplicacion NUMBER(10) GENERATED BY DEFAULT AS IDENTITY,
  pago_id_pago NUMBER(10) NOT NULL,
  factura_id_factura NUMBER(10) NOT NULL,
  importe NUMBER(12,2) NOT NULL,
  modo_conciliacion VARCHAR2(20) NOT NULL,
  estado_aplicacion VARCHAR2(20) DEFAULT 'APLICADA' NOT NULL,
  CONSTRAINT pk_aplicacion_pago PRIMARY KEY (id_aplicacion),
  CONSTRAINT fk_aplic_pago FOREIGN KEY (pago_id_pago) REFERENCES PAGO(id_pago),
  CONSTRAINT fk_aplic_factura FOREIGN KEY (factura_id_factura) REFERENCES FACTURA(id_factura),
  CONSTRAINT ck_aplic_importe CHECK (importe > 0),
  CONSTRAINT ck_aplic_modo CHECK (modo_conciliacion IN ('AUTOMATICA','MANUAL')),
  CONSTRAINT ck_aplic_estado CHECK (estado_aplicacion IN ('PENDIENTE','APLICADA','REVERTIDA'))
);
